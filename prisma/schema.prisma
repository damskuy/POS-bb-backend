generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id         Int         @id @default(autoincrement())
  name       String
  phone      String      @unique
  address    String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  vehicles   Vehicle[]
  workOrders WorkOrder[]

  @@map("customers")
}

model Vehicle {
  id           Int          @id @default(autoincrement())
  customerId   Int
  plateNumber  String       @unique
  brand        String
  model        String
  year         Int?
  transmission Transmission
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  customer     Customer     @relation(fields: [customerId], references: [id])
  workOrders   WorkOrder[]

  @@map("vehicles")
}

model Mechanic {
  id         Int         @id @default(autoincrement())
  name       String
  phone      String
  address    String?
  workOrders WorkOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("mechanics")
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  WAITING_PART
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  EWALLET
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum UserRole {
  OWNER
  ADMIN
  CASHIER
  MECHANIC
}

model Service {
  id           Int                  @id @default(autoincrement())
  name         String
  price        Int
  description  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  packageItems ServicePackageItem[]
  workOrders   WorkOrderService[]

  @@map("services")
}

model SparePart {
  id           Int                  @id @default(autoincrement())
  name         String
  sku          String?              @unique
  stock        Int                  @default(0)
  price        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  packageItems ServicePackageItem[]
  workOrders   WorkOrderPart[]

  @@map("spare_parts")
}

model ServicePackage {
  id          Int                  @id @default(autoincrement())
  name        String
  unitPrice   Int                  @default(0)
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  items       ServicePackageItem[]

  @@map("service_packages")
}

model ServicePackageItem {
  id               Int            @id @default(autoincrement())
  servicePackageId Int
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id])
  serviceId        Int?
  service          Service?       @relation(fields: [serviceId], references: [id])
  sparePartId      Int?
  sparePart        SparePart?     @relation(fields: [sparePartId], references: [id])
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  @@map("service_package_items")
}

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String @unique
  password String

  role UserRole @default(CASHIER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workOrders WorkOrder[]
  auditLogs  AuditLog[]

  @@map("users")
}

model WorkOrder {
  id Int @id @default(autoincrement())

  code String @unique

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  mechanicId Int?
  mechanic   Mechanic? @relation(fields: [mechanicId], references: [id])

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  status WorkOrderStatus @default(PENDING)

  complaint String?
  odometer  Int?
  notes     String?

  subtotal   Int @default(0)
  discount   Int @default(0)
  tax        Int @default(0)
  grandTotal Int @default(0)

  checkInAt  DateTime?
  finishedAt DateTime?

  services WorkOrderService[]
  parts    WorkOrderPart[]

  payment Payment?
  invoice Invoice?

  scheduleDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("work_orders")
}

model WorkOrderService {
  id Int @id @default(autoincrement())

  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])

  price    Int
  quantity Int @default(1)
  subtotal Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("work_order_services")
}

model WorkOrderPart {
  id Int @id @default(autoincrement())

  workOrderId Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  sparePartId Int
  sparePart   SparePart @relation(fields: [sparePartId], references: [id])

  price    Int
  quantity Int @default(1)
  subtotal Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("work_order_parts")
}

model Payment {
  id Int @id @default(autoincrement())

  workOrderId Int       @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  method PaymentMethod

  amount Int

  status PaymentStatus @default(UNPAID)

  referenceNumber String?

  paidAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("payments")
}

model Invoice {
  id Int @id @default(autoincrement())

  invoiceNumber String @unique

  workOrderId Int       @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  printedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status    String?   @default("DRAFT")
  issuedAt  DateTime? @default(now())
  deletedAt DateTime?

  @@map("invoices")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum ReminderTriggerType {
  DAYS
  KM
  BOTH
}

enum ReminderCategory {
  SERVIS
  PERAWATAN
  BAN
  KELISTRIKAN
  REM
}

model ReminderRule {
  id              Int                 @id @default(autoincrement())
  name            String
  description     String?
  category        ReminderCategory    @default(SERVIS)
  triggerType     ReminderTriggerType @default(DAYS)
  daysInterval    Int?
  kmInterval      Int?
  messageTemplate String
  sendTime        String              @default("09:00")
  timezone        String              @default("Asia/Jakarta")
  sendDays        String              @default("Senin - Sabtu")
  skipHolidays    Boolean             @default(true)
  retryOnFailure  Boolean             @default(true)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@map("reminder_rules")
}

enum NotificationCategory {
  TEST
  SERVICE_REMINDER
  WORK_ORDER_CREATED
  WORK_ORDER_UPDATED
  WORK_ORDER_COMPLETED
  VEHICLE_READY
  INVOICE_CREATED
  INVOICE
  PAYMENT_RECEIVED
  PAYMENT
  CUSTOM
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SIMULATED
  SENT
  DELIVERED
  FAILED
}

model NotificationTemplate {
  id               Int                  @id @default(autoincrement())
  name             String
  category         NotificationCategory @default(CUSTOM)
  triggerEvent     String?
  message          String
  targetRecipients String[]             @default(["customer"])
  deliveryTiming   String               @default("direct")
  delayMinutes     Int                  @default(0)
  conditions       Json?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  automations NotificationAutomation[]

  @@map("notification_templates")
}

enum NotificationTrigger {
  WORK_ORDER_CREATED
  WORK_ORDER_IN_PROGRESS
  WORK_ORDER_COMPLETED
}

model NotificationAutomation {
  id          Int                   @id @default(autoincrement())
  name        String
  description String?
  trigger     NotificationTrigger   @unique
  isEnabled   Boolean               @default(true)
  templateId  Int?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([isEnabled])
  @@map("notification_automations")
}

model NotificationHistory {
  id             String               @id @default(cuid())
  recipientName  String?
  recipientPhone String
  channel        NotificationChannel  @default(WHATSAPP)
  category       NotificationCategory
  message        String
  status         NotificationStatus   @default(PENDING)

  provider          String? @default("fonnte")
  providerMessageId String?
  providerResponse  Json?
  errorMessage      String?

  retryCount Int @default(0)

  automationId Int?
  workOrderId  Int?
  trigger      NotificationTrigger?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([recipientPhone])
  @@index([createdAt])
  @@index([workOrderId, trigger, automationId])
  @@map("notification_history")
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

model JobExecutionLog {
  id           String    @id @default(cuid())
  jobName      String
  mode         String    @default("DRY_RUN")
  status       JobStatus @default(RUNNING)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  summary      Json?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([jobName, status])
  @@index([startedAt])
  @@map("job_execution_logs")
}
